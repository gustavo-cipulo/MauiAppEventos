<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppEventos.Views.ResumoEvento"
    Title="Resumo do Evento"
    BackgroundColor="#F0F4FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,25"
            Spacing="18">

            <!-- CABEÇALHO -->
            <Label
                Text="EVENTOS PREMIUM"
                FontFamily="KalamBold"
                FontSize="34"
                TextColor="#183153"
                HorizontalTextAlignment="Center" />
            <Label
                Text="Evento cadastrado com sucesso!"
                FontSize="15"
                TextColor="#2563EB"
                HorizontalTextAlignment="Center" />

            <!-- RESUMO -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE7F2"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Resumo do Evento"
                        FontFamily="KalamBold"
                        FontSize="25"
                        TextColor="#183153" />
                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <Label
                        Text="NOME DO EVENTO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding Nome}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#183153" />

                    <Label
                        Text="LOCAL"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding Local}"
                        FontSize="15"
                        TextColor="#334155" />

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <Label
                        Text="DATA DE INÍCIO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"
                        FontSize="15"
                        TextColor="#334155" />

                    <Label
                        Text="DATA DE TÉRMINO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"
                        FontSize="15"
                        TextColor="#334155" />

                    <Label
                        Text="DURAÇÃO DO EVENTO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding DuracaoDias, StringFormat='{0} dia(s)'}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#183153" />

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <Label
                        Text="NÚMERO DE PARTICIPANTES"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding NumeroParticipantes}"
                        FontSize="15"
                        TextColor="#334155" />

                    <Label
                        Text="CUSTO POR PARTICIPANTE"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}"
                        FontSize="15"
                        TextColor="#334155" />

                </VerticalStackLayout>
            </Border>

            <!-- TOTAL -->
            <Border
                BackgroundColor="#183153"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="20">

                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="CUSTO TOTAL DO EVENTO"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#CBD5E1" />

                    <Label
                        Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="VOLTAR AO CADASTRO"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="13"
                HeightRequest="52"
                Clicked="Voltar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
